# ------------------------------------------------------------------
# Mercadinho Virtual — Template de Configuração Ambiental
# Copia este ficheiro para .env e preenche os valores reais.
# O ficheiro .env NUNCA deve ser commitado (está no .gitignore).
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de Dados (MongoDB Atlas ou local)
DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Segurança (strings longas e aleatórias — mínimo 32 caracteres)
SESSION_SECRET=insere_aqui_string_aleatoria
JWT_SECRET=insere_aqui_string_aleatoria

# ------------------------------------------------------------------
# Email — escolhe UM dos dois modos abaixo
# ------------------------------------------------------------------

# MODO 1 (recomendado): SMTP genérico — envia emails reais
# Funciona com Gmail, Outlook, SendGrid, alojamento próprio, etc.
#
# Exemplo Gmail:
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_SECURE=false
#   EMAIL_SMTP_USER=o_teu_email@gmail.com
#   EMAIL_SMTP_PASS=xxxx xxxx xxxx xxxx   <- App Password (não a password normal)
#   EMAIL_FROM=o_teu_email@gmail.com
#
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=insere_aqui
EMAIL_SMTP_PASS=insere_aqui
EMAIL_FROM=insere_aqui@gmail.com

# MODO 2: Mailtrap Sandbox — emails ficam na inbox do mailtrap.io (não chegam ao destinatário real)
# Útil para testes sem enviar emails reais.
# Obtém o MAILTRAP_INBOX_ID em: mailtrap.io → Inboxes → clicar na inbox → Settings
# Para usar este modo, comenta as variáveis EMAIL_SMTP_* acima e descomenta as de baixo:
#
# EMAIL_API_TOKEN=token_do_mailtrap
# MAILTRAP_INBOX_ID=123456
# EMAIL_FROM=noreply@teste.com
